// frontend/src/components/primitives/View.jsx
import React from "react";

export default function View({ 
  children, 
  direction = "col", // 'col' or 'row'
  gap = "0", 
  className = "", 
  style = {} 
}) {
  // Mapping simple direction prop to Tailwind flex-direction
  const flexDir = direction === "row" ? "flex-row" : "flex-col";
  const gapClass = gap !== "0" ? `gap-${gap}` : "";

  return (
    <div 
      style={style}
      className={`flex ${flexDir} ${gapClass} w-full box-border ${className}`}
    >
      {children}
    </div>
  );
}
