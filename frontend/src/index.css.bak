/* frontend/src/index.css */

@tailwind base;
@tailwind components;
@tailwind utilities;

/**
 * Global Baseline (Empire Edition)
 * -------------------------------
 * Normalizes the environment for Blue Lotus neural actuation.
 * Enforces the Ink & Cyan visual law at the root level.
 */

:root {
  background-color: #09090B; /* True Ink */
  color: #E2E8F0;           /* Off-White Data */
  color-scheme: dark;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  /* Industrial Traversal: Smooth but surgical transitions */
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

html, body, #root {
  height: 100%;
  width: 100%;
  overflow-x: hidden;
  background: #09090B;
}

body {
  /* High-Density Typography */
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 12px; 
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Custom Scrollbar (Empire Minimalist) */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(6, 182, 212, 0.3); /* Cyan Glow on Interaction */
}

/* Selection Actuation */
::selection {
  background: rgba(6, 182, 212, 0.2);
  color: #06B6D4;
}
