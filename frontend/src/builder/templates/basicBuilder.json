{
  "name": "basic-builder",
  "label": "Blue Lotus Starter",
  "description": "A high-performance Tailwind starter template.",
  "manifest": [
    { "name": "View", "label": "Layout Box", "description": "Flexbox container for layout." },
    { "name": "Container", "label": "Page Wrapper", "description": "Centered content container." },
    { "name": "Text", "label": "Typography", "description": "Heading or paragraph text." },
    { "name": "Button", "label": "Action Button", "description": "Interactive click element." },
    { "name": "Input", "label": "Data Input", "description": "Text input field." },
    { "name": "Spacer", "label": "Spacing", "description": "Vertical or horizontal gap." }
  ],
  "tokens": {
    "theme": "dark",
    "colors": {
      "background": "bg-slate-950",
      "surface": "bg-slate-900",
      "primary": "blue-600",
      "text": "text-slate-200"
    }
  },
  "nodes": [
    {
      "id": "root-1",
      "type": "Container",
      "props": { "className": "py-10" },
      "children": [
        {
          "type": "Text",
          "props": { "as": "h1", "className": "text-4xl font-bold mb-4", "children": "New Project" }
        },
        {
          "type": "View",
          "props": { "direction": "row", "gap": "4" },
          "children": [
            { "type": "Button", "props": { "label": "Get Started", "className": "bg-blue-600 text-white" } },
            { "type": "Button", "props": { "label": "Documentation", "className": "border border-slate-700" } }
          ]
        }
      ]
    }
  ]
}
