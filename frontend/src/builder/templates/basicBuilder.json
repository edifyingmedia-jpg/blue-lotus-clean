{
  "name": "basic-builder",
  "label": "Blue Lotus Architect Starter",
  "description": "Premium neural-grid starter for high-end AI applications.",
  "manifest": [
    { "name": "View", "label": "Structure Box" },
    { "name": "Container", "label": "Architectural Wrapper" },
    { "name": "Text", "label": "Typography Node" },
    { "name": "Button", "label": "Action Trigger" },
    { "name": "Input", "label": "Data Portal" },
    { "name": "Spacer", "label": "Void Spacing" }
  ],
  "tokens": {
    "theme": "dark",
    "colors": {
      "background": "bg-[#09090B]",
      "surface": "bg-[#0F0F14]",
      "primary": "cyan-500",
      "text": "text-slate-200"
    }
  },
  "nodes": [
    {
      "id": "root-1",
      "type": "Container",
      "props": { "className": "py-20 px-6 max-w-5xl mx-auto" },
      "children": [
        {
          "type": "Text",
          "props": { 
            "as": "h1", 
            "className": "text-6xl font-black tracking-tighter mb-6 text-white leading-none", 
            "children": "PROJECT_ZERO" 
          }
        },
        {
          "type": "View",
          "props": { "direction": "row", "gap": "6", "className": "items-center" },
          "children": [
            { 
              "type": "Button", 
              "props": { 
                "label": "INITIATE SESSION", 
                "className": "bg-white text-black px-8 py-4 rounded-xl font-bold tracking-widest text-xs" 
              } 
            },
            { 
              "type": "Button", 
              "props": { 
                "label": "VIEW ARCHITECTURE", 
                "className": "border border-white/10 text-slate-400 px-8 py-4 rounded-xl text-xs tracking-widest hover:text-white transition-colors" 
              } 
            }
          ]
        }
      ]
    }
  ]
}
